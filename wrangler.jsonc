{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mcp-alternance",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Jetons OAuth émis pour Claude (exigé par @cloudflare/workers-oauth-provider).
	// Créé avec : npx wrangler kv namespace create OAUTH_KV
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "0d11340dd0674fd3a1971403f74bc605"
		}
	],
	// Base de données des candidatures.
	// Créé avec : npx wrangler d1 create mcp-alternance
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mcp-alternance",
			"database_id": "80c7ef71-d926-43cf-b318-01d7fd2367eb",
			"migrations_dir": "migrations"
		}
	]
	// Secrets (jamais dans ce fichier) — à saisir avec `npx wrangler secret put <NOM>` :
	//   CLE_ACCES         clé d'accès personnelle (32 caractères aléatoires minimum)
	//   LBA_API_KEY       clé d'API La bonne alternance (type « production »)
	//   FT_CLIENT_ID      identifiant client France Travail
	//   FT_CLIENT_SECRET  clé secrète France Travail
}